---
layout: default
---
<article class="work">
  <a class="back" href="{{ '/works/' | relative_url }}">← Все работы</a>
  <h1>{{ page.title }}</h1>
  {% if page.image %}<img class="work-main-image" src="{{ page.image | relative_url }}" alt="{{ page.title }}">{% endif %}
  <div class="details">
    {% if page.category %}<div><b>Категория</b><span>{{ page.category }}</span></div>{% endif %}
    {% if page.size %}<div><b>Размер</b><span>{{ page.size }}</span></div>{% endif %}
    {% if page.materials %}<div><b>Материалы</b><span>{{ page.materials }}</span></div>{% endif %}
    {% if page.technique %}<div><b>Техника</b><span>{{ page.technique }}</span></div>{% endif %}
  </div>
  <div class="content">{{ content }}</div>
  <section class="cta">
    <h2>Связаться с автором</h2>
    <div class="socials">
      {% if site.data.settings.phone %}<a href="tel:{{ site.data.settings.phone }}">Телефон</a>{% endif %}
      {% if site.data.settings.vk %}<a href="{{ site.data.settings.vk }}">VK</a>{% endif %}
      {% if site.data.settings.telegram %}<a href="{{ site.data.settings.telegram }}">Telegram</a>{% endif %}
      {% if site.data.settings.website %}<a href="{{ site.data.settings.website }}">Личный сайт</a>{% endif %}
    </div>
  </section>
</article>
